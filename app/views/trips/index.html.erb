<section class="hero-section">
  <div class="hero-overlay">
    <div class="hero-content">
      <h1>Explore Amazing Trips</h1>
      <p>Discover destinations around the world tailored just for you</p>
    </div>
  </div>
</section>

<!-- Filters -->
<div class="filters-container">
  <%= form_with url: trips_path,
        method: :get,
        local: true,
        class: "filters-form",
        html: { id: "filtersForm" } do %>

    <%= text_field_tag :search,
          params[:search],
          placeholder: "Search by name",
          class: "input",
          id: "searchInput" %>

    <%= select_tag :min_rating,
          options_for_select([["Min Rating", ""]] + (1..5).map { |r| ["#{r}+", r] }, params[:min_rating]),
          class: "input",
          onchange: "this.form.submit();" %>

    <%= select_tag :sort,
          options_for_select([["Sort by", ""], ["Rating Ascending", "asc"], ["Rating Descending", "desc"]], params[:sort]),
          class: "input",
          onchange: "this.form.submit();" %>

    <%= link_to "Clear", trips_path, class: "btn btn-danger" %>

  <% end %>
</div>

<div class="add-trip-container">
  <button id="openModalBtn" class="btn btn-success">
    Add New Trip
  </button>
</div>

<!-- Trips Grid -->
<div class="trips-grid">
  <% @trips.each do |trip| %>
    <div class="trip-card">
      <img src="<%= trip.image_url %>" alt="<%= trip.name %>">

      <div class="trip-content">
        <h2>
          <%= link_to trip.name, trip_path(trip) %>
        </h2>

        <p class="trip-description">
          <%= trip.short_description %>
        </p>

        <p class="trip-rating">
          ⭐ <%= trip.rating %>/5
        </p>
      </div>
    </div>
  <% end %>
</div>

<!-- Pagination -->
<div class="pagination-container">
  <%= paginate @trips %>
</div>

<!-- Modal -->
<div id="tripModal" class="modal">
  <div class="modal-content">
    <span id="closeModalBtn" class="modal-close">&times;</span>

    <h2>Add a New Trip</h2>

    <%= form_with model: Trip.new, url: trips_path, local: true, class: "modal-form" do |f| %>

      <%= f.label :name %>
      <%= f.text_field :name, class: "input" %>

      <%= f.label :image_url, "Image URL" %>
      <%= f.text_field :image_url, class: "input" %>

      <%= f.label :short_description %>
      <%= f.text_field :short_description, class: "input" %>

      <%= f.label :long_description %>
      <%= f.text_area :long_description, rows: 4, class: "input" %>

      <%= f.label :rating %>
      <%= f.number_field :rating, in: 1..5, class: "input small" %>

      <%= f.submit "Create Trip", class: "btn btn-primary full" %>

    <% end %>
  </div>
</div>

<script>
  const searchInput = document.getElementById("searchInput");
  const form = document.getElementById("filtersForm");

  if (searchInput) {
    let timeout = null;

    searchInput.addEventListener("input", function () {
      clearTimeout(timeout);

      timeout = setTimeout(() => {
        form.submit();
      }, 500); // waits 500ms after typing stops
    });
  }
</script>