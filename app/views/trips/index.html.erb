<!-- app/views/trips/index.html.erb -->

<h1 style="text-align: center; margin-bottom: 30px;">All Trips</h1>

<!-- Search / Filter / Sort Form -->
<div style="max-width: 900px; margin: 0 auto 30px; text-align: center;">
  <%= form_with url: trips_path, method: :get, local: true do %>
    <input type="text" name="search" placeholder="Search by name" value="<%= params[:search] %>" style="padding: 5px; width: 200px; margin-right: 10px;">

    <select name="min_rating" style="padding: 5px; margin-right: 10px;">
      <option value="">Min Rating</option>
      <% (1..5).each do |r| %>
        <option value="<%= r %>" <%= 'selected' if params[:min_rating].to_i == r %>><%= r %>+</option>
      <% end %>
    </select>

    <select name="sort" style="padding: 5px; margin-right: 10px;">
      <option value="">Sort by</option>
      <option value="asc" <%= 'selected' if params[:sort] == 'asc' %>>Rating Ascending</option>
      <option value="desc" <%= 'selected' if params[:sort] == 'desc' %>>Rating Descending</option>
    </select>

    <button type="submit" style="padding: 5px 15px; background-color: #2c3e50; color: white; border-radius: 5px; cursor: pointer;">Apply</button>

    <!-- Clear Filters -->
    <%= link_to "Clear Filters", trips_path, style: "padding: 5px 15px; background-color: #c0392b; color: white; border-radius: 5px; text-decoration: none; margin-left: 10px;" %>
  <% end %>
</div>
<div style="text-align: center; margin-bottom: 20px;">
  <button id="openModalBtn" style="padding: 10px 20px; background-color: #27ae60; color: white; border-radius: 5px; cursor: pointer;">
    Add New Trip
  </button>
</div>
<!-- Trips Cards -->
<div style="display: flex; flex-wrap: wrap; gap: 20px; justify-content: center;">
  <% @trips.each do |trip| %>
    <div style="border: 1px solid #ddd; border-radius: 10px; width: 300px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); transition: transform 0.2s;">
      <img src="<%= trip.image_url %>" alt="<%= trip.name %>" style="width: 100%; height: 200px; object-fit: cover;">
      <div style="padding: 15px;">
        <h2 style="font-size: 1.2rem; margin-bottom: 10px;">
          <%= link_to trip.name, trip_path(trip), style: "text-decoration: none; color: #2c3e50;" %>
        </h2>
        <p style="font-size: 0.95rem; color: #555; margin-bottom: 10px;">
          <%= trip.short_description %>
        </p>
        <p style="font-weight: bold; color: #e67e22;">
          Rating: <%= trip.rating %>/5
        </p>
      </div>
    </div>
  <% end %>
</div>

<!-- Pagination -->
<div style="text-align: center; margin-top: 30px;">
  <%= paginate @trips %>
</div>
<!-- Modal Background -->
<div id="tripModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; 
     background: rgba(0,0,0,0.5); justify-content: center; align-items: center; z-index: 1000;">
  
  <!-- Modal Content -->
  <div style="background: white; padding: 20px; border-radius: 10px; width: 500px; position: relative;">
    <span id="closeModalBtn" style="position: absolute; top: 10px; right: 15px; cursor: pointer; font-weight: bold;">&times;</span>

    <h2 style="text-align: center; margin-bottom: 20px;">Add a New Trip</h2>

    <%= form_with model: Trip.new, url: trips_path, local: true do |f| %>
      <div style="margin-bottom: 10px;">
        <%= f.label :name %><br>
        <%= f.text_field :name, style: "width: 100%; padding: 5px;" %>
      </div>

      <div style="margin-bottom: 10px;">
        <%= f.label :image_url, "Image URL" %><br>
        <%= f.text_field :image_url, style: "width: 100%; padding: 5px;" %>
      </div>

      <div style="margin-bottom: 10px;">
        <%= f.label :short_description %><br>
        <%= f.text_field :short_description, style: "width: 100%; padding: 5px;" %>
      </div>

      <div style="margin-bottom: 10px;">
        <%= f.label :long_description %><br>
        <%= f.text_area :long_description, rows: 4, style: "width: 100%; padding: 5px;" %>
      </div>

      <div style="margin-bottom: 20px;">
        <%= f.label :rating %><br>
        <%= f.number_field :rating, in: 1..5, style: "width: 100px; padding: 5px;" %>
      </div>

      <%= f.submit "Create Trip", style: "padding: 10px 20px; background-color: #2c3e50; color: white; border-radius: 5px; cursor: pointer;" %>
    <% end %>
  </div>
</div>
<script>
  const openModalBtn = document.getElementById("openModalBtn");
  const closeModalBtn = document.getElementById("closeModalBtn");
  const tripModal = document.getElementById("tripModal");

  openModalBtn.addEventListener("click", () => {
    tripModal.style.display = "flex";
  });

  closeModalBtn.addEventListener("click", () => {
    tripModal.style.display = "none";
  });

  window.addEventListener("click", (e) => {
    if (e.target === tripModal) {
      tripModal.style.display = "none";
    }
  });
</script>